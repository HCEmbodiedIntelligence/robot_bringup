<?xml version="1.0"?>
<package format="3">
  <name>humanoid_gripper</name>
  <version>0.1.0</version>
  <description>Extensible gripper drivers and ROS topic adapters for independently managed grippers.</description>
  <maintainer email="czy33114@gmail.com">czy</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>humanoid_driver_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <humanoid_driver_interface plugin="${prefix}/plugins/gripper_plugins.xml"/>
  </export>
</package>
